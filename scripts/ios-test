#!/usr/bin/env bash
# iOS unit tests, run the way the app is built: xcodebuild on a simulator.
#
# `swift test` on the macOS host builds for macOS, which is a platform the app
# never ships on and a compile surface the Linux host never checks. Testing the
# package on iOS keeps one compiler, one SDK and one set of conditionals
# (`#if canImport(Darwin)`, `#if os(iOS)`) for everything this repo releases.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PKG="$ROOT/mobile/ios/CinemacoreCore"
DERIVED="${RUNNER_TEMP:-$PKG/.build}/cinemacore-tests"

command -v xcodebuild >/dev/null 2>&1 ||
  { echo "ios-test: xcodebuild is required (macOS)." >&2; exit 1; }

cd "$PKG"
xcodebuild -version

# Xcode derives one scheme per package product, plus `<package>-Package` when
# that scheme aggregates every test target.
SCHEME=$(xcodebuild -list -json 2>/dev/null | python3 -c '
import json, sys
listing = json.load(sys.stdin)
schemes = (listing.get("project") or listing.get("workspace") or {}).get("schemes") or []
aggregate = [s for s in schemes if s.endswith("-Package")]
print((aggregate or schemes or [""])[0])
')
if [ -z "$SCHEME" ]; then
  echo "ios-test: no scheme found in $PKG" >&2
  xcodebuild -list >&2 || true
  exit 1
fi

# Pick the first available iPhone rather than a hard-coded name: runner images
# change their installed runtimes between releases.
DESTINATION_ID=$(xcrun simctl list devices available -j | python3 -c '
import json, sys
devices = json.load(sys.stdin).get("devices", {})
for runtime in sorted(devices, reverse=True):
    if "iOS" not in runtime:
        continue
    for device in devices[runtime]:
        if device.get("isAvailable", True) and device.get("name", "").startswith("iPhone"):
            print(device["udid"])
            raise SystemExit
')
if [ -z "$DESTINATION_ID" ]; then
  echo "ios-test: no available iPhone simulator" >&2
  xcrun simctl list devices available >&2 || true
  exit 1
fi

echo "ios-test: scheme $SCHEME on simulator $DESTINATION_ID"
xcodebuild test \
  -scheme "$SCHEME" \
  -destination "platform=iOS Simulator,id=$DESTINATION_ID" \
  -derivedDataPath "$DERIVED"
