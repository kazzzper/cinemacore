#!/usr/bin/env node
// Generate the iOS Xcode inputs. Generated/Version.xcconfig serves the optional
// xcodebuild target; scripts/xtool asks for the concrete mode because xtool does
// not expand $(BUILD_SETTINGS).
const fs = require('node:fs');
const path = require('node:path');
const {
  ROOT,
  derive,
  tagFromArgs,
  marketingVersion,
} = require('./lib/version.cjs');

const IOS_DIR = path.join(ROOT, 'mobile', 'ios', 'Cinemacore');
const GENERATED_DIR = path.join(IOS_DIR, 'Generated');
const INFO_PLIST = path.join(IOS_DIR, 'Info.plist');

function setPlistValue(plist, key, value) {
  const pattern = new RegExp(`(<key>${key}</key>\\s*<string>)[^<]*(</string>)`);
  if (!pattern.test(plist)) {
    throw new Error(`Info.plist is missing <key>${key}</key>`);
  }
  return plist.replace(pattern, (_, open, close) => `${open}${value}${close}`);
}

function concretePlist(info, source = INFO_PLIST) {
  let plist = fs.readFileSync(source, 'utf8');
  plist = setPlistValue(plist, 'CFBundleShortVersionString', marketingVersion(info.version));
  plist = setPlistValue(plist, 'CFBundleVersion', String(info.build));
  plist = setPlistValue(plist, 'AppFullVersion', info.full);
  plist = setPlistValue(plist, 'AppCommit', info.commit);
  return plist;
}

try {
  const args = process.argv.slice(2);
  const info = derive({ tag: tagFromArgs(args) });

  // xtool does not expand $(BUILD_SETTINGS), so the wrapper asks for a concrete
  // plist with the real version for the lifetime of one build.
  const concreteIndex = args.indexOf('--concrete');
  if (concreteIndex !== -1) {
    const target = args[concreteIndex + 1];
    if (!target) throw new Error('--concrete needs an output path');
    const sourceIndex = args.indexOf('--source');
    const source = sourceIndex === -1 ? INFO_PLIST : args[sourceIndex + 1];
    if (!source) throw new Error('--source needs a plist path');
    fs.writeFileSync(target, concretePlist(info, source));
    console.log(`wrote ${target} (${info.full} ${info.build} ${info.commit})`);
    process.exit(0);
  }

  fs.mkdirSync(GENERATED_DIR, { recursive: true });

  const xcconfig = [
    '// Generated by scripts/generate-version. Do not edit.',
    `MARKETING_VERSION = ${marketingVersion(info.version)}`,
    `CURRENT_PROJECT_VERSION = ${info.build}`,
    `APP_FULL_VERSION = ${info.full}`,
    `APP_COMMIT = ${info.commit}`,
    '',
  ].join('\n');
  fs.writeFileSync(path.join(GENERATED_DIR, 'Version.xcconfig'), xcconfig);

  let plist = fs.readFileSync(INFO_PLIST, 'utf8');
  plist = setPlistValue(plist, 'CFBundleShortVersionString', '$(MARKETING_VERSION)');
  plist = setPlistValue(plist, 'CFBundleVersion', '$(CURRENT_PROJECT_VERSION)');
  plist = setPlistValue(plist, 'AppFullVersion', '$(APP_FULL_VERSION)');
  plist = setPlistValue(plist, 'AppCommit', '$(APP_COMMIT)');
  fs.writeFileSync(path.join(GENERATED_DIR, 'Info.plist'), plist);

  console.log(`wrote ${path.relative(ROOT, GENERATED_DIR)}/Version.xcconfig`);
  console.log(`wrote ${path.relative(ROOT, GENERATED_DIR)}/Info.plist`);
  console.log(`  ${info.full} (${info.build}) ${info.commit}`);
} catch (error) {
  console.error(`generate-version: ${error.message}`);
  process.exit(1);
}
