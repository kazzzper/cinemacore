#!/usr/bin/env node
// Print the release identity used by every platform. CI appends --env output to
// $GITHUB_ENV so one step feeds Android, iOS, web and the artifact checks.
const fs = require('node:fs');
const {
  derive,
  tagFromArgs,
  marketingVersion,
} = require('./lib/version.cjs');

const args = process.argv.slice(2);
const json = args.includes('--json');
const env = args.includes('--env');
const check = args.includes('--check');
const github = args.includes('--github');

try {
  const info = derive({ tag: tagFromArgs(args) });

  if (check) {
    if (process.argv.includes('--tag') || process.env.GITHUB_REF_TYPE === 'tag') {
      console.log(`VERSION ${info.tag} matches the tag`);
    } else {
      console.log(`VERSION ${info.full} is valid (build ${info.build})`);
    }
  } else if (json) {
    console.log(JSON.stringify({
      version: info.full,
      tag: info.tag,
      marketing: marketingVersion(info.version),
      build: info.build,
      commit: info.commit,
    }, null, 2));
  } else if (env || github) {
    // GITHUB_ENV is a plain KEY=VALUE file, not a shell script.
    const lines = [
      `APP_VERSION=${info.full}`,
      `APP_FULL_VERSION=${info.full}`,
      `MARKETING_VERSION=${info.marketing}`,
      `APP_BUILD_NUMBER=${info.build}`,
      `APP_COMMIT=${info.commit}`,
      `APP_TAG=${info.tag}`,
    ];
    if (github && process.env.GITHUB_ENV) {
      fs.appendFileSync(process.env.GITHUB_ENV, `${lines.join('\n')}\n`);
    } else {
      console.log(lines.join('\n'));
    }
    if (github) {
      // Values from GITHUB_ENV are only visible to later steps, so anything
      // consumed in this one has to come from GITHUB_OUTPUT.
      const prerelease = `prerelease=${info.full.includes('-')}`;
      if (process.env.GITHUB_OUTPUT) {
        fs.appendFileSync(process.env.GITHUB_OUTPUT, `${prerelease}\n`);
      } else {
        console.log(prerelease);
      }
    }
  } else {
    console.log(`version   ${info.full}`);
    console.log(`tag       ${info.tag}`);
    console.log(`marketing ${info.marketing}`);
    console.log(`build     ${info.build}`);
    console.log(`commit    ${info.commit}`);
  }
} catch (error) {
  console.error(`version: ${error.message}`);
  process.exit(1);
}
