#!/usr/bin/env bash
# The one unsigned iOS pipeline: device .ipa + simulator .app, verified against
# VERSION and packaged into release/. CI and `make ios-release` both call this.
#
# Xcode does the build. `xtool dev generate-xcode-project` only supplies the app
# target, and the concrete version goes into the plist that target already
# points at: passing INFOPLIST_FILE/GENERATE_INFOPLIST_FILE on the command line
# also hits SwiftPM's resource bundles and stops them generating their plists.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IOS="$ROOT/mobile/ios/Cinemacore"
APP="${IOS_PRODUCT:-Cinemacore}"
OUT="$ROOT/release"
TMP="$(mktemp -d)"
PROJECT_INFO=""
restore_plist() {
  [ -n "$PROJECT_INFO" ] && [ -f "$TMP/project-Info.plist" ] &&
    cp "$TMP/project-Info.plist" "$PROJECT_INFO"
}
trap 'restore_plist; rm -rf "$TMP"' EXIT

VERSION_ENV=$(node "$ROOT/scripts/version" --env)
eval "$VERSION_ENV"
APP_TAG="${APP_TAG:-v${APP_FULL_VERSION}}"
for name in APP_FULL_VERSION APP_BUILD_NUMBER APP_COMMIT MARKETING_VERSION APP_TAG; do
  eval "value=\${$name:-}"
  [ -n "$value" ] || { echo "ios-build: $name missing from scripts/version --env" >&2; exit 1; }
done

cd "$ROOT"
node scripts/generate-version

if ! command -v xcodebuild >/dev/null 2>&1; then
  echo "ios-build: xcodebuild is required (macOS). On Linux use make ios-ipa." >&2
  exit 1
fi
if ! command -v xtool >/dev/null 2>&1; then
  echo "ios-build: xtool is required to generate the Xcode project" >&2
  exit 1
fi

cd "$IOS"
xtool dev generate-xcode-project
PROJECT="$IOS/xtool/.xtool-tmp/Cinemacore.xcodeproj"
PROJECT_INFO="$IOS/xtool/.xtool-tmp/Cinemacore/Info.plist"
TARGET="${IOS_TARGET:-$APP-App}"
if [ ! -d "$PROJECT" ] || [ ! -f "$PROJECT_INFO" ]; then
  echo "ios-build: xtool did not write a usable project under $IOS/xtool/.xtool-tmp" >&2
  exit 1
fi
cp "$PROJECT_INFO" "$TMP/project-Info.plist"
node "$ROOT/scripts/generate-version" --concrete "$PROJECT_INFO" --source "$TMP/project-Info.plist"

build_xcode() {
  xcodebuild \
    -project "$PROJECT" \
    -target "$TARGET" \
    -configuration Release \
    -sdk "$1" \
    SYMROOT="$2" OBJROOT="$2/obj" \
    CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" \
    build
}
build_xcode iphoneos "$TMP/device"
build_xcode iphonesimulator "$TMP/sim"

DEVICE_APP=$(find "$TMP/device/Release-iphoneos" -maxdepth 1 -name '*.app' | head -1)
SIM_APP=$(find "$TMP/sim/Release-iphonesimulator" -maxdepth 1 -name '*.app' | head -1)
test -n "$DEVICE_APP" || { echo "ios-build: no device .app under $TMP" >&2; exit 1; }
test -n "$SIM_APP" || { echo "ios-build: no simulator .app under $TMP" >&2; exit 1; }

mkdir -p "$TMP/Payload"
cp -R "$DEVICE_APP" "$TMP/Payload/"
IPA="$TMP/Cinemacore-${APP_TAG}-unsigned.ipa"
(cd "$TMP" && zip -qry "$IPA" Payload)

check_plist() {
  python3 - "$1" "$APP_FULL_VERSION" "$APP_BUILD_NUMBER" "$APP_COMMIT" "$MARKETING_VERSION" <<'PY'
import plistlib, sys
path, full, build, commit, marketing = sys.argv[1:]
with open(path, "rb") as fh:
    plist = plistlib.load(fh)
expected = {
    "AppFullVersion": full,
    "CFBundleVersion": build,
    "AppCommit": commit,
    "CFBundleShortVersionString": marketing,
}
for key, want in expected.items():
    got = plist.get(key)
    if str(got) != want:
        sys.exit(f"{key}={got!r}, expected {want!r} in {path}")
PY
}
check_plist "$DEVICE_APP/Info.plist"
check_plist "$SIM_APP/Info.plist"

mkdir -p "$OUT"
cp "$IPA" "$OUT/Cinemacore-${APP_TAG}-unsigned.ipa"
(cd "$(dirname "$SIM_APP")" && zip -qry "$OUT/Cinemacore-${APP_TAG}-simulator.app.zip" "$(basename "$SIM_APP")")

echo "ios-build: ${APP_FULL_VERSION} (${APP_BUILD_NUMBER}) ${APP_COMMIT}"
echo "  release/Cinemacore-${APP_TAG}-unsigned.ipa"
echo "  release/Cinemacore-${APP_TAG}-simulator.app.zip"
