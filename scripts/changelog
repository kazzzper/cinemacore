#!/usr/bin/env node
// Build a Markdown section from Conventional Commits. Kept dependency-free so
// it runs on the same Node the tasks CLI already requires.
const { execFileSync } = require('node:child_process');
const { ROOT } = require('./lib/version.cjs');

const SECTIONS = [
  ['feat', 'Features'],
  ['fix', 'Bug Fixes'],
  ['perf', 'Performance'],
  ['refactor', 'Refactoring'],
  ['docs', 'Documentation'],
  ['build', 'Build'],
  ['ci', 'CI'],
  ['test', 'Tests'],
  ['style', 'Style'],
];

const HIDDEN = /^(chore\(release\)|chore\(tasks\)|docs\(release\))/;

function git(args) {
  return execFileSync('git', args, {
    cwd: ROOT,
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore'],
  }).trim();
}

function lastTag() {
  try {
    return git(['describe', '--tags', '--abbrev=0', '--match', 'v*']);
  } catch {
    return '';
  }
}

function commits(range) {
  const output = git([
    'log',
    '--no-merges',
    '--pretty=format:%s%x1f%b%x1e',
    range || 'HEAD',
  ]);
  if (!output) return [];

  return output
    .split('\x1e')
    .map((record) => record.trim())
    .filter(Boolean)
    .map((record) => {
      const [subject, ...body] = record.split('\x1f');
      const match = /^(\w+)(?:\(([^)]+)\))?(!)?: (.+)$/.exec(subject);
      return {
        subject,
        body: body.join('\x1f'),
        type: match?.[1],
        scope: match?.[2],
        breaking: Boolean(match?.[3]) || /BREAKING CHANGE:/.test(body.join('\n')),
        summary: match?.[4] ?? subject,
      };
    })
    .filter((commit) => !HIDDEN.test(commit.subject));
}

function render(version, date, range) {
  const list = commits(range);
  const breaking = list.filter((commit) => commit.breaking);
  const lines = [`## [${version}] - ${date}`, ''];

  if (breaking.length > 0) {
    lines.push('### Breaking Changes', '');
    for (const commit of breaking) {
      lines.push(`- ${entry(commit)}`);
    }
    lines.push('');
  }

  for (const [type, title] of SECTIONS) {
    const matching = list.filter((commit) => commit.type === type && !commit.breaking);
    if (matching.length === 0) continue;
    lines.push(`### ${title}`, '');
    for (const commit of matching) {
      lines.push(`- ${entry(commit)}`);
    }
    lines.push('');
  }

  const other = list.filter(
    (commit) =>
      !commit.breaking &&
      !SECTIONS.some(([type]) => type === commit.type),
  );
  if (other.length > 0) {
    lines.push('### Other', '');
    for (const commit of other) {
      lines.push(`- ${entry(commit)}`);
    }
    lines.push('');
  }

  if (list.length === 0) {
    lines.push('No changes recorded.', '');
  }

  return `${lines.join('\n').trimEnd()}\n`;
}

function entry(commit) {
  const scope = commit.scope ? `**${commit.scope}:** ` : '';
  return `${scope}${commit.summary}`;
}

function option(name) {
  const index = process.argv.indexOf(name);
  return index === -1 ? null : process.argv[index + 1];
}

const version = option('--version');
if (!version) {
  console.error('usage: scripts/changelog --version X.Y.Z[-channel.N] [--range <git-range>]');
  process.exit(2);
}

const date = option('--date') || new Date().toISOString().slice(0, 10);
const range = option('--range') ?? lastTag();
process.stdout.write(render(version, date, range));
