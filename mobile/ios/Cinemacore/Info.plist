<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This target uses a hand-written Info.plist, so Xcode only injects
	     CFBundleIdentifier/CFBundleExecutable when GENERATE_INFOPLIST_FILE is
	     on (it is not, here). Without them the app cannot be installed or
	     launched, so the identity lives in the plist. Concrete values because
	     xtool does not expand $(BUILD_SETTINGS). Keep them in step with
	     PRODUCT_BUNDLE_IDENTIFIER/PRODUCT_NAME in the project and bundleID in
	     xtool.yml. -->
	<key>CFBundleIdentifier</key>
	<string>com.cinemacore.app</string>
	<key>CFBundleExecutable</key>
	<string>Cinemacore</string>
	<key>CFBundleName</key>
	<string>Cinemacore</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDisplayName</key>
	<string>Cinemacore</string>
	<!-- Copied to the .app root by the project's Copy Root Resources phase. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Concrete dev fallbacks: xtool does not expand $(BUILD_SETTINGS). CI
	     regenerates Generated/Info.plist plus Version.xcconfig from the tag. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<key>AppFullVersion</key>
	<string>0.0.0-dev</string>
	<key>AppCommit</key>
	<string>local</string>

	<!-- TMDB v3 API key for the StreamHype catalog source (Settings › Data
	     source). Leave this empty to use StreamHype's published client key;
	     paste your own key here (or set `TMDB_API_KEY` in the environment)
	     to use your account's quota instead. -->
	<key>TMDBAPIKey</key>
	<string></string>

	<!-- The brand is dark-only; see docs/adr for the rationale. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- Launch screen: the aperture mark over the app's own obsidian
	     background, so the first frame already looks like the product. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>SplashLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- The default gateway is a loopback address, so only local networking is
	     exempted. App Transport Security is otherwise left at its defaults; a
	     global NSAllowsArbitraryLoads would be a release blocker. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Audio keeps playing when the app leaves the foreground, which is also
	     what picture-in-picture requires. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Request signing uses MD5/SHA-256/HMAC, which are not encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
