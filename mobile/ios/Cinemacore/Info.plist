<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Cinemacore</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- TMDB v3 API key for the StreamHype catalog source (Settings › Data
	     source). Register at themoviedb.org → Settings → API and paste the
	     key here. Deliberately empty in source: a committed key cannot be
	     rotated, and it would be the registering account's, not the user's.
	     `TMDB_API_KEY` in the environment takes precedence when present. -->
	<key>TMDBAPIKey</key>
	<string></string>

	<!-- The brand is dark-only; see docs/adr for the rationale. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- Launch screen: the aperture mark over the app's own obsidian
	     background, so the first frame already looks like the product. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>SplashLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- The default gateway is a loopback address, so only local networking is
	     exempted. App Transport Security is otherwise left at its defaults; a
	     global NSAllowsArbitraryLoads would be a release blocker. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Audio keeps playing when the app leaves the foreground, which is also
	     what picture-in-picture requires. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Request signing uses MD5/SHA-256/HMAC, which are not encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
